{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pokemath",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	// The site lives on its own domain, where the Worker is the lock (worker/auth.js); the
	// workers.dev address is off, so there is one way in.
	"workers_dev": false,
	"routes": [{ "pattern": "pokemath.amediocre.dad", "custom_domain": true }],
	"preview_urls": false,
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": true
	},
	// TEAM_DOMAIN and POLICY_AUD come from the Access application that covers only
	// pokemath.amediocre.dad/login/email; see worker/auth.js.
	// BINGO_JURISDICTION keeps the bingo Durable Object in the EU; D1 is created with --jurisdiction=eu.
	// TEACHER_EMAILS, the email logins that may use the teacher pages (comma-separated), is a
	// secret, so the addresses stay out of this public repo: wrangler secret put TEACHER_EMAILS.
	"vars": { "TEAM_DOMAIN": "https://mediocrity.cloudflareaccess.com", "POLICY_AUD": "6148ab65fc83a271d80d572a9617756a1468756b4905ce5b5f6cc6d089a73d77", "BINGO_JURISDICTION": "eu" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pokemath",
			"database_id": "f9ffa71f-5e12-40e8-af9f-1ebb5ed8b97b",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "BINGO", "class_name": "BingoHub" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BingoHub"] }],
	"observability": { "enabled": true }
}
