{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pokemath",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": true
	},
	// TEAM_DOMAIN and POLICY_AUD come from the Access application; see worker/access.js.
	"vars": { "TEAM_DOMAIN": "", "POLICY_AUD": "" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pokemath",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "BINGO", "class_name": "BingoHub" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BingoHub"] }],
	"observability": { "enabled": true }
}
