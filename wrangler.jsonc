{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pokemath",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": true
	},
	// TEAM_DOMAIN and POLICY_AUD come from the Access application; see worker/access.js.
	// BINGO_JURISDICTION keeps the bingo Durable Object in the EU; D1 is created with --jurisdiction=eu.
	"vars": { "TEAM_DOMAIN": "", "POLICY_AUD": "", "BINGO_JURISDICTION": "eu" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pokemath",
			"database_id": "f9ffa71f-5e12-40e8-af9f-1ebb5ed8b97b",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "BINGO", "class_name": "BingoHub" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BingoHub"] }],
	"observability": { "enabled": true }
}
